const reg=b.getSheetByName('Induction Register'),days=reg.getRange('F2:F');reg.setConditionalFormatRules([SpreadsheetApp.newConditionalFormatRule().whenNumberLessThan(0).setBackground('#fde2e4').setFontColor('#b3261e').setRanges([days]).build(),SpreadsheetApp.newConditionalFormatRule().whenNumberBetween(0,30).setBackground('#fff4d6').setFontColor('#8a6100').setRanges([days]).build()]);
