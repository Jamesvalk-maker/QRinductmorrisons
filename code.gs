os.getRange('G1').setValue('On site now').setFontWeight('bold');os.getRange('H1').setFormula('=ARRAYFORMULA(IFERROR(ROWS('+onsite+'),0))').setFontWeight('bold').setFontSize(14);}
function config(){return {site:CFG.site,test:!CFG.live,questions:QUIZ.map(x=>({text:x[0],options:[x[1],...x[2]]})),survey:SURVEY,work:WORK};}
function session_(token){if(typeof token!=='string'||!/^[a-f0-9-]{36}$/.test(token))throw Error('Please start again.');const raw=CacheService.getScriptCache().get('session:'+token);if(!raw)throw Error('Your session expired. Please start again.');const s=JSON.parse(raw);if(s.version!==CFG.version||s.live!==CFG.live)throw Error('The app was updated. Please start again.');return s;}
function saveSession_(token,s){CacheService.getScriptCache().put('session:'+token,JSON.stringify(s),3600);}
function currentInduction_(key,now){const today=day_(now);return rows_(tab_(names_().induction),11).reverse().find(r=>r[1]===CFG.site&&r[5]===key&&r[8]===CFG.version&&r[9]===true&&r[6] instanceof Date&&validAge_(day_(r[6]),today));}
function begin(p){const id=identity_(p);if(!['Sign In','Sign Out'].includes(p.action))throw Error('Choose sign in or sign out.');tab_(names_().attendance);const s={...id,action:p.action,version:CFG.version,live:CFG.live,seen:[],attempts:0,created:Date.now(),fresh:false};const token=Utilities.getUuid();let required=false;if(p.action==='Sign In')required=!currentInduction_(id.key,new Date());const known=rows_(tab_(names_().induction),11).reverse().find(r=>r[1]===CFG.site&&r[5]===id.key);if(known)s.name=String(known[2]);s.required=required;s.slides=required?inductionCount_():0;saveSession_(token,s);return {token,required,slides:s.slides};}
/* All pages are delivered together so the induction scrolls like one document; the client unlocks the quiz only after every page has been scrolled to its end. */
/* Building the induction is slow: the Form is opened and every image fetched and encoded. The finished pages are kept in the script cache in chunks under the 100KB-per-key limit, and warmInduction() rebuilds them on a timer so nobody waits for the Form. The id changes whenever the pages do. */
const IND_CHUNK=90000,IND_TTL=21600;
/* Slide images are often large PNG exports. An opaque PNG (colour type 0 or 2, no alpha channel) re-encoded as JPEG is usually several times smaller and looks the same; anything that may have transparency is left alone so it never gains a black background. */
function slimImage_(blob){const b=blob.getBytes();if(blob.getContentType()!=='image/png'||b.length<200000)return blob;const colour=b[25]&255;if(colour!==0&&colour!==2)return blob;try{const j=blob.getAs('image/jpeg');return j.getBytes().length<b.length*0.7?j:blob;}catch(e){return blob;}}
function buildInduction_(){const pages=source_().map((img,i)=>{const b=slimImage_(img.getImage());return {title:img.getTitle()||'Induction page '+(i+1),description:img.getHelpText()||'',data:'data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes())};});const json=JSON.stringify(pages),id=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,json)).slice(0,16),n=Math.ceil(json.length/IND_CHUNK),items={};for(let i=0;i<n;i++)items['ind:'+id+':'+i]=json.slice(i*IND_CHUNK,(i+1)*IND_CHUNK);try{const c=CacheService.getScriptCache();c.putAll(items,IND_TTL);c.put('ind:meta',JSON.stringify({id,n,count:pages.length}),IND_TTL);}catch(e){console.warn('Induction not cached: '+e.message);}PropertiesService.getScriptProperties().setProperty('inductionCount',String(pages.length));return {id,pages};}
function inductionMeta_(){return JSON.parse(CacheService.getScriptCache().get('ind:meta')||'null');}
function induction_(){const meta=inductionMeta_();if(meta){const keys=Array.from({length:meta.n},(_,i)=>'ind:'+meta.id+':'+i),got=CacheService.getScriptCache().getAll(keys);if(keys.every(k=>got[k]!=null))return {id:meta.id,pages:JSON.parse(keys.map(k=>got[k]).join(''))};}return buildInduction_();}
/* Counting pages must stay cheap: never build the whole induction just to count it. */
function inductionCount_(){const meta=inductionMeta_();if(meta)return meta.count;const saved=Number(PropertiesService.getScriptProperties().getProperty('inductionCount'));return saved>0?saved:source_().length;}
/* Run from the editor to see where induction loading time goes. Results appear in the execution log. */
function diagnoseInduction(){const out=[],t0=Date.now(),images=source_();out.push('Form opened and read: '+(Date.now()-t0)+' ms, '+images.length+' images');let raw=0,slim=0;images.forEach((img,i)=>{const t=Date.now(),blob=img.getImage(),fetched=Date.now()-t,b=blob.getBytes(),png=blob.getContentType()==='image/png',size=png?((b[16]&255)<<24|(b[17]&255)<<16|(b[18]&255)<<8|(b[19]&255))+'x'+((b[20]&255)<<24|(b[21]&255)<<16|(b[22]&255)<<8|(b[23]&255)):'',s2=slimImage_(blob).getBytes().length;raw+=b.length;slim+=s2;out.push('Page '+(i+1)+': '+blob.getContentType()+' '+size+' '+Math.round(b.length/1024)+' KB -> '+Math.round(s2/1024)+' KB, fetched in '+fetched+' ms');});out.push('Total images: '+(raw/1048576).toFixed(1)+' MB, after slimming '+(slim/1048576).toFixed(1)+' MB (about '+(slim*1.37/1048576).toFixed(1)+' MB sent to each phone)');const t1=Date.now();buildInduction_();out.push('Full build: '+(Date.now()-t1)+' ms');const t2=Date.now(),meta=inductionMeta_(),cached=meta&&induction_();out.push(meta?'Cache: OK, read back in '+(Date.now()-t2)+' ms ('+meta.n+' chunks)':'Cache: FAILED - the induction is too large to cache, so it is rebuilt for every person');console.log(out.join('\n'));return out.join('\n');}
function warmInduction(){return buildInduction_().pages.length+' induction pages cached';}
/* Public so a phone can start downloading the pages while the person is still typing their details. */
function induction(){return induction_();}
/* Marks the pages as delivered for this session. If the phone already holds the current pages (have === id) nothing is sent back. */
function material(token,have){const s=session_(token);if(!s.required)throw Error('Invalid material request.');const meta=inductionMeta_(),current=meta&&have===meta.id?null:induction_(),count=current?current.pages.length:meta.count;if(count!==s.slides)throw Error('The induction has changed. Please start again.');s.seen=Array.from({length:count},(_,i)=>i);saveSession_(token,s);return current||{id:meta.id};}
function completeInduction(token,answers,declared){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=session_(token);if(s.fresh)return {ok:true};if(!s.required||declared!==true||s.seen.length!==s.slides)throw Error('Read every induction page and confirm the declaration first.');s.attempts++;if(s.attempts>10)throw Error('Please restart the induction and review the material.');saveSession_(token,s);const bad=answers_(answers);if(bad.length)return {ok:false,incorrect:bad};const sheet=tab_(names_().induction);const existing=rows_(sheet,11).find(r=>r[0]===token);if(!existing){const now=new Date();append_(sheet,[token,CFG.site,s.name,s.company,s.phone,s.key,now,isoDay_(day_(now)+365),CFG.version,true,JSON.stringify(answers.map(x=>tidy_(x,160)))]);}s.fresh=true;s.answers=answers;s.required=false;saveSession_(token,s);return {ok:true};}finally{lock.releaseLock();}}
function receipt_(token){const row=rows_(tab_(names_().receipts),4).find(r=>r[0]===token);return row?JSON.parse(row[3]):null;}
function visit_(p,action){const kind=tidy_(p.kind);if(!['Contractor','Visitor'].includes(kind))throw Error('Choose contractor or visitor.');if(action==='Sign Out'){const scope=kind==='Visitor'?'Visiting Only (Non Contractor)':tidy_(p.scope);if(![SURVEY,WORK,'Visiting Only (Non Contractor)'].includes(scope))throw Error('Choose the work completed.');if(scope===WORK&&(p.permitConfirmed!==true||!String(p.permitNumber||'').trim()))throw Error('Confirm permit sign-off and enter its number.');return {kind,scope,permit:scope===WORK?tidy_(p.permitNumber,60):''};}const reason=tidy_(p.reason,1000);const scope=kind==='Visitor'?'':tidy_(p.scope);if(kind==='Contractor'&&![SURVEY,WORK].includes(scope))throw Error('Choose your work type.');if(scope===WORK&&p.permitConfirmed!==true)throw Error('Confirm that you will sign on to a permit to work.');return {kind,scope,reason};}
function submitVisit(token,p){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=session_(token),old=receipt_(token);if(old)return old;const v=visit_(p,s.action),now=new Date();if(s.action==='Sign In'&&!currentInduction_(s.key,now))throw Error('A current completed induction is required. Please start again.');const sheet=tab_(names_().attendance);const h=sheet.getRange(1,1,1,22).getValues()[0];if(h[0]!=='Timestamp'||h[4]!=='Contact Number'||h[21]!=='Full Name')throw Error('Attendance columns have changed. No record was written.');const row=Array(22).fill('');/* The name goes in C for sign-outs too, so every row says who it is; V keeps the Form's sign-out name column filled for existing formulas. */row[0]=now;row[1]=s.action;row[2]=s.name;row[3]=s.company;row[4]=s.phone;if(s.action==='Sign In'){row[5]=s.fresh?'No':'Yes';if(s.fresh){row[6]=DECLARATION;s.answers.forEach((a,i)=>row[7+i]=a);}row[14]=v.kind;row[15]=v.reason;row[16]=v.scope;row[17]=v.scope===WORK?'Yes':'';}else{row[18]=v.scope===WORK?'Maintenance Works or Surveys behind locked areas':v.scope;row[19]=v.permit;row[20]=v.scope===WORK?'Yes':'';row[21]=s.name;}/* Pending receipts make uncertain writes visible rather than silently retrying. */const receiptSheet=tab_(names_().receipts);const receiptRow=append_(receiptSheet,[token,now,s.key,JSON.stringify({ok:false,pending:true,message:'This submission needs checking before retrying. Please contact the site.'})]);append_(sheet,row);const result={ok:true,action:s.action,test:!CFG.live,message:s.action==='Sign Out'?'You are signed out.':'Your sign-in is recorded. '+(v.scope===WORK?'You must sign on to a permit to work before starting any maintenance.':v.kind==='Contractor'?'Please make yourself known to a manager in Ambient or Fresh before proceeding.':'Please report to your site contact.')};receiptSheet.getRange(receiptRow,4).setValue(JSON.stringify(result));SpreadsheetApp.flush();return result;}finally{lock.releaseLock();}}
function runChecks(){let n=0;const check=(v,m)=>{if(!v)throw Error(m);n++;};check(validAge_(100,100),'same day');check(validAge_(100,464),'day 364');check(!validAge_(100,465),'day 365 expired');check(!validAge_(101,100),'future date');check(phone_('+44 7700 900123')==='07700900123','UK normalisation');check(phone_('0044 7700 900123')==='07700900123','international prefix');check(identity_({name:' Jane  Smith ',company:'Example',phone:'07700900123'}).key==='jane smith|07700900123','identity');check(identity_({name:'Jane Smith',company:'Example',phone:'+447700900123'}).phone==='07700900123','+44 stored as 07');let landline=false;try{identity_({name:'Jane Smith',company:'Example',phone:'+441234567890'});}catch(e){landline=true;}check(landline,'mobile only');check(answers_(QUIZ.map(q=>q[1])).length===0,'correct answers');check(answers_(QUIZ.map((q,i)=>[1,3,4].includes(i)?q[2][0]:q[1])).join(',')==='2,4,5','wrong options rejected');check(answers_(QUIZ.map(q=>' '+q[1])).length===QUIZ.length,'only exact options accepted');check(QUIZ.every(q=>q[2].length===3&&!q[2].includes(q[1])),'quiz options');check(safe_('=IMPORTXML(1)')[0]==="'",'formula injection');check(visit_({kind:'Visitor',reason:'Meeting'},'Sign In').scope==='','visitor');let rejected=false;try{visit_({kind:'Contractor',scope:WORK,reason:'Repair'},'Sign In');}catch(e){rejected=true;}check(rejected,'permit required');console.log(n+' checks passed');return n+' checks passed';}

function formatTestTabs(){if(CFG.live)throw Error('Test sheets only.');const specs=[['App Test Attendance',[180,130,190,180,150,130,260,210,210,210,210,210,210,240,150,260,260,220,260,150,220,190]],['App Test Inductions',[280,150,190,180,150,300,180,140,150,130,400]],['App Test Receipts',[280,180,300,460]]];for(const [name,widths] of specs){const s=tab_(name);widths.forEach((w,i)=>s.setColumnWidth(i+1,w));const area=s.getRange(1,1,Math.max(2,s.getLastRow()),widths.length);area.setWrap(true).setVerticalAlignment('top');s.setRowHeight(1,name==='App Test Attendance'?120:48);if(s.getLastRow()>1)s.autoResizeRows(2,s.getLastRow()-1);s.setFrozenRows(1);}console.log('Test tab formatting updated.');}
